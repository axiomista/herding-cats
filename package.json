{
  "name": "herding-cats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "box-node-sdk": "^4.18.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "fuzzball": "^2.2.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "description": "Finds promises made in Box documents that no Box Task tracks",
  "scripts": {
    "dev": "tsc -p web && (tsc -w -p web --preserveWatchOutput & tsx watch --env-file=.env src/server.ts)",
    "build": "tsc -p tsconfig.build.json && tsc -p web && node scripts/copy-web.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\" \"test/replay/**/*.test.ts\"",
    "eval": "tsx scripts/eval.ts"
  }
}
