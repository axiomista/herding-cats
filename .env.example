# Copy to .env and fill in. Never commit .env.
BOX_CLIENT_ID=your-client-id
BOX_CLIENT_SECRET=your-client-secret
BOX_ENTERPRISE_ID=your-enterprise-id
BOX_SCAN_FOLDER_ID=428423214478
BOX_AUDIT_FOLDER_ID=428424620757
BOX_WEBHOOK_PRIMARY_KEY=your-primary-signature-key
BOX_WEBHOOK_SECONDARY_KEY=your-secondary-signature-key
MODE=dry-run
SWEEP_INTERVAL_MINUTES=15
